# 线束管理平台 ECS 生产环境（wire.houmq.cn）
# 用法：
#   cp deploy/.env.ecs.example /opt/wire-harness-deploy/.env
#   编辑密钥后：sudo bash scripts/bootstrap-ecs.sh
# CI 更新：bash scripts/deploy-ecs.sh

# ---- 部署 ----
DEPLOY_CLEANUP_DOCKER=1
DEPLOY_CLEANUP_KEEP_DAYS=1
ECS_ENV_FILE=/opt/wire-harness-deploy/.env

# ---- 镜像（CI retag 目标）----
WIRE_HARNESS_BACKEND_IMAGE=wire-harness-backend:ecs
WIRE_HARNESS_WEB_IMAGE=wire-harness-web:ecs

# ---- 站点 ----
SITE_ADDRESS=wire.houmq.cn
PUBLIC_SITE_URL=https://wire.houmq.cn/
CORS_ALLOWED_ORIGINS=https://wire.houmq.cn

# shared-caddy（默认，与 LIMS 同机共享 443）| standalone-caddy | host-nginx
WIRE_HARNESS_EDGE_MODE=shared-caddy
MAIN_LIMS_DIR=/opt/lims-deploy
WEB_HOST_PORT=127.0.0.1:8096:80

# ---- 前端构建（GitHub Actions 注入；生产由 Caddy 同源 /api）----
VITE_API_BASE_URL=https://wire.houmq.cn/
VITE_PASSWORD_ENCRYPT_KEY=${PASSWORD_ENCRYPT_KEY}

# ---- 数据库（数据目录 /data/wire-harness，与 LIMS /data/lims 隔离）----
DB_NAME=wire_harness
DB_USER=wire_harness
DB_PASSWORD=PLEASE_GENERATE
DB_HOST=postgres
DB_PORT=5432
DB_SSL_MODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=PLEASE_GENERATE
REDIS_MAXMEMORY=128mb

# ---- 密钥（openssl rand -hex 32）----
JWT_SECRET=PLEASE_GENERATE
JWT_REFRESH_SECRET=PLEASE_GENERATE
PASSWORD_ENCRYPT_KEY=PLEASE_GENERATE

# ---- 默认管理员（migrate 后生效）----
# LIMS_ADMIN_PASSWORD=qwer.123
