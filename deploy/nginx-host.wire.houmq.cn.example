# 主机 Nginx：wire.houmq.cn → 线束平台 Docker 8096
# 与 cnas.houmq.cn 等同机：追加到 /etc/nginx/sites-enabled/houmq.cn
# 证书：certbot --expand houmq.cn 增加 wire.houmq.cn 后复用 houmq.cn 证书

server {
    server_name wire.houmq.cn;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/houmq.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/houmq.cn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = wire.houmq.cn) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name wire.houmq.cn;
    return 404;
}
