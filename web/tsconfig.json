{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/router/**/*",
    "src/pages/login/**/*",
    "src/pages/ledger/**/*",
    "src/layouts/**/*",
    "src/api/auth.ts",
    "src/api/client.ts",
    "src/api/harnessLedger.ts",
    "src/api/me.ts",
    "src/api/types.ts",
    "src/stores/authStore.ts",
    "src/hooks/useAuth.ts",
    "src/hooks/useHarnessLedger.ts",
    "src/hooks/useTableParams.ts",
    "src/hooks/useContainerTableBodyHeight.ts",
    "src/hooks/useIsMobile.ts",
    "src/hooks/chainSelectOpenChange.ts",
    "src/components/**/*",
    "src/constants/tableLayout.ts",
    "src/constants/permissions.ts",
    "src/constants/developerUser.ts",
    "src/utils/authSession.ts",
    "src/utils/encrypt.ts",
    "src/utils/sha256.ts",
    "src/utils/appMessage.ts",
    "src/utils/trace.ts",
    "src/utils/platform.ts",
    "src/utils/userDisplay.ts",
    "src/utils/permissionAbility.ts",
    "src/utils/accessToken.ts",
    "src/lib/**/*",
    "src/theme/**/*",
    "src/styles/**/*",
    "src/edition/**/*",
    "src/queryClient.ts",
    "vite.config.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
